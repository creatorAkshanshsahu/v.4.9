# Response headers — Netlify / Cloudflare Pages both read this file.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The embed route is the only page a third party may frame.
# Widen `frame-ancestors` here — and nowhere else — to the partners you have agreed to.
/embed.html
  Content-Security-Policy: frame-ancestors 'self'
  Cache-Control: public, max-age=60

# The site itself must never sit inside someone else's frame.
/index.html
  Content-Security-Policy: frame-ancestors 'none'

/watch.html
  Content-Security-Policy: frame-ancestors 'self'
