<!-- Springy lift for glass controls: scale + elevation on focus (remote), a soft press-in on touch. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.96" android:duration="90"/>
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.96" android:duration="90"/>
        </set>
    </item>
    <item android:state_focused="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.06" android:duration="300" android:interpolator="@android:interpolator/overshoot"/>
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.06" android:duration="300" android:interpolator="@android:interpolator/overshoot"/>
            <objectAnimator android:propertyName="translationZ" android:valueTo="8dp" android:duration="220"/>
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:duration="200" android:interpolator="@android:interpolator/decelerate_quad"/>
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:duration="200" android:interpolator="@android:interpolator/decelerate_quad"/>
            <objectAnimator android:propertyName="translationZ" android:valueTo="0dp" android:duration="200"/>
        </set>
    </item>
</selector>
