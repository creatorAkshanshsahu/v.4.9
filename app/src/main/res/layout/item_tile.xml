<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="216dp" android:layout_height="122dp" android:layout_margin="10dp"
    android:focusable="true" android:clickable="true" android:clipToOutline="true"
    android:foreground="@drawable/focus_ring" android:background="@drawable/poster_round">
    <ImageView android:id="@+id/logo" android:layout_width="62dp" android:layout_height="62dp"
        android:layout_gravity="center_horizontal|top" android:layout_marginTop="18dp" android:scaleType="fitCenter"/>
    <TextView android:id="@+id/mono" android:layout_width="56dp" android:layout_height="56dp"
        android:layout_gravity="center_horizontal|top" android:layout_marginTop="21dp" android:gravity="center"
        android:textColor="#FFFFFF" android:textSize="19sp" android:fontFamily="@font/sora_bold"
        android:includeFontPadding="false" android:visibility="gone"/>
    <TextView android:id="@+id/fav" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_margin="8dp" android:text="♥" android:textColor="@color/brand"
        android:textSize="14sp" android:visibility="gone"/>
    <!-- Same bottom scrim as the poster rail: the copy lives on the artwork, not on a plate under it. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical" android:paddingStart="12dp"
        android:paddingEnd="12dp" android:paddingTop="22dp" android:paddingBottom="10dp"
        android:background="@drawable/poster_scrim">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <View android:id="@+id/healthDot" android:layout_width="6dp" android:layout_height="6dp"
                android:layout_marginEnd="6dp" android:background="@drawable/dot" android:backgroundTint="@color/brand"/>
            <TextView android:id="@+id/liveBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="LIVE" android:background="@drawable/live_pill" android:textColor="@color/brand"
                android:textSize="8sp" android:fontFamily="@font/sora_bold" android:letterSpacing="0.1"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="1dp"
                android:paddingBottom="1dp" android:includeFontPadding="false"/>
        </LinearLayout>
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/text"
            android:textSize="13sp" android:fontFamily="@font/sora_bold" android:includeFontPadding="false"/>
        <TextView android:id="@+id/nowCaption" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="1dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/text_dim"
            android:textSize="9sp" android:fontFamily="@font/manrope"/>
    </LinearLayout>
</FrameLayout>
