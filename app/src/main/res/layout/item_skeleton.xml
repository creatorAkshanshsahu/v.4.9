<!-- Loading placeholder: a breathing 7:10 card with caption bars, sized by HomeChrome.styleTile like a poster. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="148dp" android:layout_height="wrap_content" android:layout_margin="10dp"
    android:orientation="vertical" android:focusable="false" android:clickable="false">
    <FrameLayout android:id="@+id/posterArt" android:layout_width="match_parent" android:layout_height="211dp"
        android:clipToOutline="true" android:background="@drawable/poster_round">
        <View android:id="@+id/skelGlow" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="#12273B63"/>
    </FrameLayout>
    <View android:layout_width="96dp" android:layout_height="10dp" android:layout_marginTop="9dp"
        android:layout_marginStart="2dp" android:background="@drawable/skel_bar"/>
    <View android:layout_width="64dp" android:layout_height="8dp" android:layout_marginTop="6dp"
        android:layout_marginStart="2dp" android:background="@drawable/skel_bar"/>
</LinearLayout>
