<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/abyss">
    <FrameLayout android:id="@+id/heroMedia" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_gravity="top" android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
        android:layout_marginTop="80dp" android:clipToOutline="true" android:background="@drawable/hero_card">
        <FrameLayout android:id="@+id/heroOrb" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <View android:id="@+id/heroGlow" android:layout_width="480dp" android:layout_height="480dp"
            android:layout_gravity="top|end" android:layout_marginTop="-150dp" android:layout_marginEnd="100dp"
            android:background="@drawable/home_glow"/>
        <ImageView android:id="@+id/heroBackdrop" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:visibility="gone" android:alpha="0"/>
        <FrameLayout android:id="@+id/heroPreview" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0" android:visibility="gone">
            <androidx.media3.ui.PlayerView android:id="@+id/heroPreviewPv" android:layout_width="match_parent"
                android:layout_height="match_parent" android:focusable="false" app:use_controller="false"
                app:resize_mode="zoom" app:surface_type="texture_view" app:use_artwork="false"
                app:shutter_background_color="@android:color/transparent"/>
        </FrameLayout>
        <View android:id="@+id/heroTreatment" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/scrim_hero_cinematic" android:importantForAccessibility="no"/>
        <ImageView android:id="@+id/heroLogo" android:layout_width="210dp" android:layout_height="132dp"
            android:layout_gravity="top|end" android:layout_marginTop="42dp" android:layout_marginEnd="56dp" android:scaleType="fitCenter"/>
        <TextView android:id="@+id/heroLogoCaption" android:layout_width="170dp" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:layout_marginTop="150dp" android:layout_marginEnd="56dp"
            android:gravity="center" android:text="STREAMR" android:textColor="@color/text" android:textSize="12sp"
            android:fontFamily="@font/sora_semibold" android:letterSpacing="0.18" android:visibility="gone"/>
        <TextView android:id="@+id/heroMono" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:layout_marginTop="42dp" android:layout_marginEnd="68dp" android:textColor="#FFFFFF"
            android:textSize="68sp" android:fontFamily="@font/sora_bold" android:includeFontPadding="false" android:visibility="gone"/>
        <TextView android:id="@+id/heroTagline" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:layout_marginTop="72dp" android:layout_marginEnd="34dp"
            android:gravity="end" android:text="A BRIGHTER\nTOMORROW\nLIVES HERE" android:textColor="@color/text"
            android:textSize="9sp" android:fontFamily="@font/sora_semibold" android:letterSpacing="0.26"
            android:lineSpacingExtra="2dp" android:includeFontPadding="false"/>
    </FrameLayout>
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:paddingTop="92dp" android:orientation="vertical" clipChildren="false">
        <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="84dp"
            android:paddingStart="28dp" android:paddingEnd="30dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@drawable/home_top_scrim">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/sectionKicker" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="YOUR FRONT ROW" android:textSize="9sp" android:letterSpacing="0.18" android:textColor="@color/signal" android:fontFamily="@font/sora_semibold"/>
                <TextView android:id="@+id/sectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:text="Live TV" android:textSize="27sp" android:textColor="@color/text" android:fontFamily="@font/sora_semibold"/>
            </LinearLayout>
            <TextView android:id="@+id/librarySummary" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginEnd="22dp" android:text="LIVE + ON DEMAND" android:textColor="@color/text_faint"
                android:textSize="10sp" android:fontFamily="@font/sora_semibold" android:letterSpacing="0.05"/>
            <TextClock android:id="@+id/homeClock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:maxLines="1" android:textColor="@color/text_dim"
                android:textSize="13sp" android:fontFamily="@font/sora_regular"/>
        </LinearLayout>
        <HorizontalScrollView android:id="@+id/phoneNavScroll" android:layout_width="match_parent" android:layout_height="48dp"
            android:visibility="gone" android:paddingStart="14dp" android:paddingEnd="14dp" android:clipToPadding="false"
            android:overScrollMode="never" android:scrollbars="none">
            <LinearLayout android:id="@+id/phoneNav" android:layout_width="wrap_content" android:layout_height="match_parent"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/phoneBrand" android:layout_width="48dp" android:layout_height="42dp"
                    android:layout_marginEnd="8dp" android:src="@drawable/streamr_mark_small" android:scaleType="fitCenter"
                    android:contentDescription="STREAMR"/>
                <TextView android:id="@+id/phoneLive" style="@style/Widget.AKTV.PhonePill" android:text="Live"/>
                <TextView android:id="@+id/phoneJio" style="@style/Widget.AKTV.PhonePill" android:text="JioTV"/>
                <TextView android:id="@+id/phoneMovies" style="@style/Widget.AKTV.PhonePill" android:text="Movies"/>
                <TextView android:id="@+id/phoneSeries" style="@style/Widget.AKTV.PhonePill" android:text="Series"/>
                <TextView android:id="@+id/phoneSearch" style="@style/Widget.AKTV.PhonePill" android:text="Search"/>
            </LinearLayout>
        </HorizontalScrollView>
        <FrameLayout android:id="@+id/heroArea" android:layout_width="match_parent" android:layout_height="230dp">
            <LinearLayout android:id="@+id/heroText" android:layout_width="400dp" android:layout_height="wrap_content"
                android:layout_marginStart="52dp" android:layout_marginBottom="24dp" android:layout_gravity="start|bottom" android:orientation="vertical">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/heroDot" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="LIVE" android:textColor="@color/amber" android:textSize="11sp" android:fontFamily="@font/sora_semibold" android:letterSpacing="0.28"/>
                    <TextView android:id="@+id/heroBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="14dp" android:textColor="@color/text_dim" android:textSize="13sp"
                        android:fontFamily="@font/manrope"/>
                </LinearLayout>
                <TextView android:id="@+id/heroTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:maxLines="2" android:ellipsize="end" android:textColor="@color/text"
                    android:textSize="44sp" android:fontFamily="@font/sora_bold" android:lineSpacingMultiplier="0.98" android:includeFontPadding="false"/>
                <TextView android:id="@+id/heroSubheading" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:visibility="gone" android:maxLines="1" android:ellipsize="end"
                    android:textColor="@color/text_dim" android:textSize="13sp" android:fontFamily="@font/manrope"/>
                <TextView android:id="@+id/heroProg" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/text" android:textSize="12sp" android:visibility="gone"/>
                <ProgressBar android:id="@+id/heroProgress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="210dp" android:layout_height="2dp" android:max="1000" android:layout_marginTop="7dp" android:visibility="gone"/>
                <TextView android:id="@+id/heroDesc" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:maxLines="3" android:ellipsize="end" android:textColor="@color/text_dim"
                    android:textSize="14sp" android:lineSpacingExtra="3dp" android:fontFamily="@font/manrope"/>
                <TextView android:id="@+id/heroNext" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/text_faint" android:textSize="10sp" android:visibility="gone"/>
                <LinearLayout android:id="@+id/heroChips" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:orientation="horizontal"/>
            </LinearLayout>
        </FrameLayout>
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="28dp" android:textColor="@color/text_dim" android:textSize="12sp"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:paddingTop="16dp" android:paddingBottom="30dp" android:clipToPadding="false" android:clipChildren="false"
            android:overScrollMode="never" android:requiresFadingEdge="none" android:fadeScrollbars="false"/>
    </LinearLayout>
    <!-- Streamr top bar, as on the site: wordmark left, glass pill tabs centred, round search and profile right. -->
    <LinearLayout android:id="@+id/navRail" android:layout_width="match_parent" android:layout_height="76dp"
        android:layout_gravity="top" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="28dp" android:paddingEnd="28dp">
        <ImageView android:id="@+id/brandMark" android:layout_width="36dp" android:layout_height="36dp"
            android:layout_marginEnd="10dp" android:src="@drawable/streamr_mark" android:scaleType="fitCenter"
            android:contentDescription="STREAMR"/>
        <TextView android:id="@+id/akText" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="STREAMR" android:textSize="22sp" android:letterSpacing="-0.02"
            android:includeFontPadding="false" android:textColor="@color/amber"
            android:fontFamily="@font/sora_bold"/>
        <TextView android:id="@+id/railTagline" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:visibility="gone" android:text="BY AKSHANSH"/>
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <LinearLayout android:id="@+id/navPills" android:layout_width="wrap_content" android:layout_height="42dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="5dp" android:paddingEnd="5dp" android:background="@drawable/nav_glass">
            <TextView android:id="@+id/segLive" style="@style/Widget.STREAMR.Pill" android:text="Live TV"
                android:nextFocusDown="@id/rows" android:nextFocusRight="@id/segJio"/>
            <TextView android:id="@+id/segJio" style="@style/Widget.STREAMR.Pill" android:text="JioTV"
                android:nextFocusLeft="@id/segLive" android:nextFocusRight="@id/segSites" android:nextFocusDown="@id/rows"/>
            <TextView android:id="@+id/segSites" style="@style/Widget.STREAMR.Pill" android:text="Movies"
                android:nextFocusLeft="@id/segJio" android:nextFocusRight="@id/segSeries" android:nextFocusDown="@id/rows"/>
            <TextView android:id="@+id/segSeries" style="@style/Widget.STREAMR.Pill" android:text="Series"
                android:nextFocusLeft="@id/segSites" android:nextFocusRight="@id/searchBtn" android:nextFocusDown="@id/rows"/>
        </LinearLayout>
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <TextView android:id="@+id/searchBtn" android:layout_width="38dp" android:layout_height="38dp"
            android:layout_marginEnd="10dp" android:gravity="center" android:focusable="true" android:clickable="true"
            android:background="@drawable/circle_glass" android:contentDescription="Search"
            android:nextFocusLeft="@id/segSeries" android:nextFocusDown="@id/rows"/>
        <LinearLayout android:id="@+id/navProfile" android:layout_width="38dp" android:layout_height="38dp"
            android:gravity="center" android:background="@drawable/circle_glass">
            <TextView android:id="@+id/profileAvatar" android:layout_width="38dp" android:layout_height="38dp"
                android:gravity="center" android:background="@drawable/profile_avatar" android:text="A"
                android:textColor="@color/abyss" android:textSize="14sp" android:fontFamily="@font/sora_bold"/>
        </LinearLayout>
        <TextView android:id="@+id/navVersion" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:visibility="gone" android:textColor="@color/text_faint" android:textSize="9sp"/>
    </LinearLayout>
LinearLayout>
</FrameLayout>
