<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/flix_screen">
    <!-- Living aurora in STREAMR neon: slow colour fields drifting behind the glass container. -->
    <com.aktv.app.AuroraView android:id="@+id/aurora" android:layout_width="match_parent" android:layout_height="match_parent"
        android:alpha="0.85" android:importantForAccessibility="no"/>
    <!-- The whole screen sits in one big rounded glass container, as in the reference design. -->
    <LinearLayout android:id="@+id/flixContainer" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"
        android:orientation="vertical" android:background="@drawable/flix_container"
        android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="6dp" android:paddingBottom="6dp" clipChildren="false">
        <!-- Top bar: wordmark left, dark tab pill centred, bell and profile right. -->
        <LinearLayout android:id="@+id/navRail" android:layout_width="match_parent" android:layout_height="76dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/brandMark" android:layout_width="36dp" android:layout_height="36dp"
                android:layout_marginEnd="10dp" android:src="@drawable/streamr_mark" android:scaleType="fitCenter"
                android:contentDescription="STREAMR" android:visibility="gone"/>
            <TextView android:id="@+id/akText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="STREAMR" android:textSize="22sp" android:includeFontPadding="false"
                android:textColor="#FFFFFF" android:fontFamily="@font/sora_bold"/>
            <TextView android:id="@+id/railTagline" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:visibility="gone" android:text="BY AKSHANSH"/>
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <HorizontalScrollView android:id="@+id/navPillScroll" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:overScrollMode="never" android:scrollbars="none" android:clipToPadding="false"
                android:paddingTop="4dp" android:paddingBottom="4dp">
                <LinearLayout android:id="@+id/navPills" android:layout_width="wrap_content" android:layout_height="42dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="5dp" android:paddingEnd="5dp" android:background="@drawable/flix_pill">
                    <TextView android:id="@+id/segLive" style="@style/Widget.STREAMR.Pill" android:text="Live TV"
                        android:nextFocusDown="@id/heroMedia" android:nextFocusRight="@id/segJio"/>
                    <TextView android:id="@+id/segJio" style="@style/Widget.STREAMR.Pill" android:text="JioTV"
                        android:nextFocusLeft="@id/segLive" android:nextFocusRight="@id/segPortal" android:nextFocusDown="@id/heroMedia"/>
                    <TextView android:id="@+id/segPortal" style="@style/Widget.STREAMR.Pill" android:text="maxTV"
                        android:nextFocusLeft="@id/segJio" android:nextFocusRight="@id/segFusion" android:nextFocusDown="@id/heroMedia"/>
                    <TextView android:id="@+id/segFusion" style="@style/Widget.STREAMR.Pill" android:text="Fusion"
                        android:nextFocusLeft="@id/segPortal" android:nextFocusRight="@id/segSites" android:nextFocusDown="@id/heroMedia"/>
                    <TextView android:id="@+id/segSites" style="@style/Widget.STREAMR.Pill" android:text="Movies"
                        android:nextFocusLeft="@id/segFusion" android:nextFocusRight="@id/segSeries" android:nextFocusDown="@id/heroMedia"/>
                    <TextView android:id="@+id/segSeries" style="@style/Widget.STREAMR.Pill" android:text="Series"
                        android:nextFocusLeft="@id/segSites" android:nextFocusRight="@id/segOg" android:nextFocusDown="@id/heroMedia"/>
                    <TextView android:id="@+id/segOg" style="@style/Widget.STREAMR.Pill" android:text="OG"
                        android:nextFocusLeft="@id/segSeries" android:nextFocusRight="@id/segStar" android:nextFocusDown="@id/heroMedia"/>
                    <TextView android:id="@+id/segStar" style="@style/Widget.STREAMR.Pill" android:text="StarShare"
                        android:nextFocusLeft="@id/segOg" android:nextFocusRight="@id/searchBtn" android:nextFocusDown="@id/heroMedia"/>
                    <TextView android:id="@+id/searchBtn" android:layout_width="34dp" android:layout_height="34dp"
                        android:layout_marginStart="2dp" android:gravity="center" android:focusable="true" android:clickable="true"
                        android:contentDescription="Search"
                        android:nextFocusLeft="@id/segStar" android:nextFocusDown="@id/heroCard2"/>
                </LinearLayout>
            </HorizontalScrollView>
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <FrameLayout android:id="@+id/flixBellBox" android:layout_width="38dp" android:layout_height="38dp"
                android:layout_marginEnd="10dp">
                <TextView android:id="@+id/flixBell" android:layout_width="38dp" android:layout_height="38dp"
                    android:gravity="center" android:focusable="true" android:clickable="true"
                    android:background="@drawable/circle_glass" android:contentDescription="Updates"
                    android:nextFocusLeft="@id/searchBtn" android:nextFocusRight="@id/navProfile" android:nextFocusDown="@id/heroCard2"/>
                <View android:id="@+id/flixBellBadge" android:layout_width="10dp" android:layout_height="10dp"
                    android:layout_gravity="top|end" android:layout_marginTop="2dp" android:layout_marginEnd="2dp"
                    android:background="@drawable/flix_badge" android:visibility="gone"/>
            </FrameLayout>
            <LinearLayout android:id="@+id/navProfile" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:focusable="true" android:clickable="true"
                android:paddingStart="4dp" android:paddingTop="4dp" android:paddingBottom="4dp"
                android:nextFocusLeft="@id/flixBell" android:nextFocusDown="@id/heroCard2">
                <TextView android:id="@+id/profileAvatar" android:layout_width="34dp" android:layout_height="34dp"
                    android:gravity="center" android:background="@drawable/profile_avatar" android:text="S"
                    android:textColor="@color/abyss" android:textSize="14sp" android:fontFamily="@font/sora_bold"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:orientation="vertical">
                    <TextView android:id="@+id/flixUserName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="STREAMR" android:textColor="#FFFFFF" android:textSize="12sp"
                        android:fontFamily="@font/sora_semibold" android:includeFontPadding="false"/>
                    <TextView android:id="@+id/flixUserSub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Member" android:textColor="@color/flix_tab_idle" android:textSize="9sp"
                        android:fontFamily="@font/sora_regular" android:includeFontPadding="false"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:text="∨" android:textColor="@color/flix_tab_idle" android:textSize="12sp"/>
            </LinearLayout>
            <TextView android:id="@+id/navVersion" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:visibility="gone" android:textColor="@color/text_faint" android:textSize="9sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" clipChildren="false">
            <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="0dp"
                android:visibility="gone" android:orientation="horizontal">
                <TextView android:id="@+id/librarySummary" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="LIVE + ON DEMAND"/>
                <TextClock android:id="@+id/homeClock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:format12Hour="h:mm a" android:format24Hour="HH:mm"/>
            </LinearLayout>
            <HorizontalScrollView android:id="@+id/phoneNavScroll" android:layout_width="match_parent" android:layout_height="48dp"
                android:visibility="gone" android:paddingStart="4dp" android:paddingEnd="4dp" android:clipToPadding="false"
                android:overScrollMode="never" android:scrollbars="none">
                <LinearLayout android:id="@+id/phoneNav" android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/phoneBrand" android:layout_width="40dp" android:layout_height="40dp"
                        android:layout_marginEnd="8dp" android:src="@drawable/streamr_mark_small" android:scaleType="fitCenter"
                        android:contentDescription="STREAMR"/>
                    <TextView android:id="@+id/phoneLive" style="@style/Widget.AKTV.PhonePill" android:text="Live"/>
                    <TextView android:id="@+id/phoneJio" style="@style/Widget.AKTV.PhonePill" android:text="JioTV"/>
                    <TextView android:id="@+id/phonePortal" style="@style/Widget.AKTV.PhonePill" android:text="maxTV"/>
                    <TextView android:id="@+id/phoneFusion" style="@style/Widget.AKTV.PhonePill" android:text="Fusion"/>
                    <TextView android:id="@+id/phoneMovies" style="@style/Widget.AKTV.PhonePill" android:text="Movies"/>
                    <TextView android:id="@+id/phoneSeries" style="@style/Widget.AKTV.PhonePill" android:text="Series"/>
                    <TextView android:id="@+id/phoneOg" style="@style/Widget.AKTV.PhonePill" android:text="OG"/>
                    <TextView android:id="@+id/phoneStar" style="@style/Widget.AKTV.PhonePill" android:text="StarShare"/>
                    <TextView android:id="@+id/phoneSearch" style="@style/Widget.AKTV.PhonePill" android:text="Search"/>
                </LinearLayout>
            </HorizontalScrollView>
            <!-- Two hero cards: the feature narrow left, the next one wide right. -->
            <LinearLayout android:id="@+id/heroArea" android:layout_width="match_parent" android:layout_height="190dp"
                android:layout_marginTop="6dp" android:orientation="horizontal" clipChildren="false">
                <FrameLayout android:id="@+id/heroMedia" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="38" android:layout_marginEnd="7dp" android:clipToOutline="true"
                    android:background="@drawable/flix_hero_card" android:foreground="@drawable/flix_ring"
                    android:focusable="true" android:clickable="true"
                    android:nextFocusRight="@id/heroCard2" android:nextFocusDown="@id/flixChips">
                    <FrameLayout android:id="@+id/heroOrb" android:layout_width="match_parent" android:layout_height="match_parent"/>
                    <View android:id="@+id/heroGlow" android:layout_width="480dp" android:layout_height="480dp"
                        android:layout_gravity="top|end" android:layout_marginTop="-150dp" android:layout_marginEnd="100dp"
                        android:background="@drawable/home_glow" android:visibility="gone"/>
                    <ImageView android:id="@+id/heroBackdrop" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:scaleType="centerCrop" android:visibility="gone" android:alpha="0"/>
                    <FrameLayout android:id="@+id/heroPreview" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0" android:visibility="gone">
                        <androidx.media3.ui.PlayerView android:id="@+id/heroPreviewPv" android:layout_width="match_parent"
                            android:layout_height="match_parent" android:focusable="false" app:use_controller="false"
                            app:resize_mode="zoom" app:surface_type="texture_view" app:use_artwork="false"
                            app:shutter_background_color="@android:color/transparent"/>
                    </FrameLayout>
                    <View android:id="@+id/heroTreatment" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/flix_hero_scrim" android:importantForAccessibility="no"/>
                    <ImageView android:id="@+id/heroLogo" android:layout_width="56dp" android:layout_height="56dp"
                        android:layout_gravity="top|end" android:layout_marginTop="14dp" android:layout_marginEnd="16dp"
                        android:scaleType="fitCenter"/>
                    <TextView android:id="@+id/heroLogoCaption" android:layout_width="170dp" android:layout_height="wrap_content"
                        android:layout_gravity="top|end" android:gravity="center" android:text="STREAMR"
                        android:visibility="gone"/>
                    <TextView android:id="@+id/heroMono" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="top|end" android:textColor="#FFFFFF" android:textSize="48sp"
                        android:fontFamily="@font/sora_bold" android:includeFontPadding="false" android:visibility="gone"/>
                    <TextView android:id="@+id/heroTagline" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="top|end" android:visibility="gone" android:text=""/>
                    <LinearLayout android:id="@+id/heroText" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_gravity="bottom" android:orientation="vertical"
                        android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="14dp">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                            <TextView android:id="@+id/heroDot" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="LIVE" android:textColor="@color/flix_caption" android:textSize="10sp"
                                android:fontFamily="@font/sora_semibold" android:letterSpacing="0.28" android:visibility="gone"/>
                            <TextView android:id="@+id/heroBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="@color/flix_caption" android:textSize="11sp" android:fontFamily="@font/manrope"/>
                        </LinearLayout>
                        <TextView android:id="@+id/heroTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFF"
                            android:textSize="28sp" android:fontFamily="@font/sora_bold" android:lineSpacingMultiplier="0.98" android:includeFontPadding="false"/>
                        <TextView android:id="@+id/heroSubheading" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:visibility="gone" android:maxLines="1" android:ellipsize="end"/>
                        <TextView android:id="@+id/heroProg" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="12sp" android:visibility="gone"/>
                        <ProgressBar android:id="@+id/heroProgress" style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="210dp" android:layout_height="2dp" android:max="1000" android:layout_marginTop="7dp" android:visibility="gone"/>
                        <TextView android:id="@+id/heroDesc" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:maxLines="2" android:ellipsize="end" android:textColor="@color/flix_caption"
                            android:textSize="12sp" android:fontFamily="@font/manrope" android:visibility="gone"/>
                        <TextView android:id="@+id/heroNext" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/flix_caption" android:textSize="10sp" android:visibility="gone"/>
                        <TextView android:id="@+id/heroPlayLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:maxLines="1" android:text="▶   Play" android:textColor="#FFFFFF"
                            android:textSize="13sp" android:fontFamily="@font/sora_semibold" android:includeFontPadding="false"/>
                        <LinearLayout android:id="@+id/heroChips" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:orientation="horizontal" android:visibility="gone"/>
                    </LinearLayout>
                </FrameLayout>
                <FrameLayout android:id="@+id/heroCard2" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="62" android:layout_marginStart="7dp" android:clipToOutline="true"
                    android:background="@drawable/flix_hero_card" android:foreground="@drawable/flix_ring"
                    android:focusable="true" android:clickable="true"
                    android:nextFocusLeft="@id/heroMedia" android:nextFocusDown="@id/flixChips">
                    <ImageView android:id="@+id/hero2Backdrop" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:scaleType="centerCrop"/>
                    <View android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/flix_hero_scrim" android:importantForAccessibility="no"/>
                    <LinearLayout android:id="@+id/hero2Text" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_gravity="bottom" android:orientation="vertical"
                        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="14dp">
                        <TextView android:id="@+id/hero2Badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:maxLines="1" android:ellipsize="end" android:textColor="@color/flix_caption"
                            android:textSize="11sp" android:fontFamily="@font/manrope"/>
                        <TextView android:id="@+id/hero2Title" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFF"
                            android:textSize="26sp" android:fontFamily="@font/sora_bold" android:lineSpacingMultiplier="0.98" android:includeFontPadding="false"/>
                        <TextView android:id="@+id/hero2Play" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:maxLines="1" android:text="▶   Play" android:textColor="#FFFFFF"
                            android:textSize="13sp" android:fontFamily="@font/sora_semibold" android:includeFontPadding="false"/>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
            <!-- The chip strip: trending, genres, categories. Built per tab in code. -->
            <HorizontalScrollView android:id="@+id/flixChipScroll" android:layout_width="match_parent" android:layout_height="46dp"
                android:layout_marginTop="8dp" android:overScrollMode="never" android:scrollbars="none"
                android:clipToPadding="false" android:paddingTop="3dp" android:paddingBottom="3dp">
                <LinearLayout android:id="@+id/flixChips" android:layout_width="wrap_content" android:layout_height="match_parent"
                    android:orientation="horizontal" android:gravity="center_vertical"/>
            </HorizontalScrollView>
            <!-- The section header: "Trending in Animation" with the sort/filter pill. -->
            <LinearLayout android:id="@+id/sectionHeader" android:layout_width="match_parent" android:layout_height="52dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:id="@+id/sectionKicker" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:visibility="gone" android:text=""/>
                    <TextView android:id="@+id/sectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Live TV" android:textColor="#FFFFFF" android:textSize="24sp"
                        android:fontFamily="@font/sora_bold" android:includeFontPadding="false"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/flixViewPill" android:layout_width="wrap_content" android:layout_height="40dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="6dp" android:paddingEnd="6dp" android:background="@drawable/flix_pill">
                    <ImageView android:id="@+id/flixSortBtn" android:layout_width="36dp" android:layout_height="36dp"
                        android:padding="8dp" android:src="@drawable/ic_sort" android:scaleType="fitCenter"
                        android:focusable="true" android:clickable="true" android:contentDescription="Sort shelves"
                        android:nextFocusRight="@id/flixFilterBtn" android:nextFocusDown="@id/rows"/>
                    <View android:layout_width="1dp" android:layout_height="18dp" android:background="#33FFFFFF"/>
                    <ImageView android:id="@+id/flixFilterBtn" android:layout_width="36dp" android:layout_height="36dp"
                        android:padding="8dp" android:src="@drawable/ic_filter" android:scaleType="fitCenter"
                        android:focusable="true" android:clickable="true" android:contentDescription="Filter shelves"
                        android:nextFocusLeft="@id/flixSortBtn" android:nextFocusDown="@id/rows"/>
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/flix_ink" android:textSize="12sp" android:visibility="gone"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:paddingTop="8dp" android:paddingBottom="30dp" android:clipToPadding="false" android:clipChildren="false"
                android:overScrollMode="never" android:requiresFadingEdge="none" android:fadeScrollbars="false"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
