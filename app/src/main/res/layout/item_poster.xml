<!-- The reference rail card: 2:3 artwork with the title and rating/year counters beneath it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="148dp" android:layout_height="wrap_content" android:layout_margin="10dp"
    android:orientation="vertical" android:focusable="true" android:clickable="true">
    <FrameLayout android:id="@+id/posterArt" android:layout_width="match_parent" android:layout_height="211dp"
        android:clipToOutline="true" android:background="@drawable/poster_round"
        android:foreground="@drawable/flix_ring_poster" android:duplicateParentState="true">
        <ImageView android:id="@+id/poster" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <TextView android:id="@+id/posterName" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:padding="12dp" android:textColor="#FFFFFF" android:textSize="12sp"
            android:fontFamily="@font/sora_semibold"/>
        <TextView android:id="@+id/posterRank" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="start|top" android:paddingStart="8dp" android:paddingTop="2dp"
            android:includeFontPadding="false" android:textColor="#B3FFFFFF" android:textSize="40sp"
            android:fontFamily="@font/sora_bold" android:visibility="gone"/>
        <LinearLayout android:id="@+id/posterProgressTrack" android:layout_width="match_parent" android:layout_height="3dp"
            android:layout_gravity="bottom" android:orientation="horizontal" android:weightSum="1"
            android:background="#40FFFFFF" android:visibility="gone">
            <View android:id="@+id/posterProgressFill" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="0" android:background="@color/brand_light"/>
        </LinearLayout>
    </FrameLayout>
    <TextView android:id="@+id/posterTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="7dp" android:paddingStart="2dp" android:paddingEnd="2dp"
        android:maxLines="1" android:singleLine="true" android:ellipsize="marquee" android:marqueeRepeatLimit="marquee_forever"
        android:textColor="#FFFFFF" android:textSize="12sp" android:fontFamily="@font/sora_bold" android:includeFontPadding="false"/>
    <TextView android:id="@+id/posterMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:paddingStart="2dp" android:paddingEnd="2dp"
        android:maxLines="1" android:ellipsize="end" android:textColor="@color/flix_poster_meta"
        android:textSize="10sp" android:fontFamily="@font/sora_regular" android:includeFontPadding="false"/>
</LinearLayout>
