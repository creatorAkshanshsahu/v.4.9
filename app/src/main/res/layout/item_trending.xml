<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="220dp" android:layout_height="142dp" android:layout_margin="6dp"
    android:focusable="true" android:clickable="true" android:clipToOutline="true"
    android:background="@drawable/poster_card_bg" android:foreground="@drawable/focus_ring">
    <ImageView android:id="@+id/trendingImage" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:contentDescription=""/>
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/trending_scrim"/>
    <TextView android:id="@+id/trendingRank" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|start" android:layout_margin="10dp" android:textColor="#CCFFFFFF"
        android:textSize="11sp" android:fontFamily="@font/sora_bold" android:letterSpacing="0.1"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="18dp" android:paddingBottom="10dp">
        <TextView android:id="@+id/trendingTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textColor="@color/text" android:textSize="14sp"
            android:fontFamily="@font/sora_bold"/>
        <TextView android:id="@+id/trendingMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:textColor="@color/text_dim"
            android:textSize="10sp" android:fontFamily="@font/sora_regular"/>
    </LinearLayout>
</FrameLayout>
