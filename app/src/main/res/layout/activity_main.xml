<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/abyss">

    <include layout="@layout/home_content"/>

    <!-- search: on-screen keyboard on the left, live results on the right -->
    <FrameLayout android:id="@+id/searchLayer" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#FA080B14" android:visibility="gone" android:clickable="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:id="@+id/searchBody" android:layout_marginStart="28dp" android:layout_marginEnd="28dp" android:layout_marginTop="24dp"
            android:layout_marginBottom="36dp" android:orientation="horizontal">
            <LinearLayout android:id="@+id/searchInputColumn" android:layout_width="340dp" android:layout_height="match_parent" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Search"
                    android:textColor="@color/text" android:textSize="26sp" android:fontFamily="@font/sora_bold"/>
                <TextView android:id="@+id/searchQuery" android:layout_width="match_parent" android:layout_height="56dp"
                    android:layout_marginTop="14dp" android:layout_marginBottom="14dp" android:gravity="center_vertical"
                    android:paddingStart="20dp" android:paddingEnd="20dp" android:singleLine="true" android:ellipsize="start"
                    android:textSize="20sp" android:fontFamily="@font/sora_regular"/>
                <LinearLayout android:id="@+id/searchKeys" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="24dp" android:orientation="vertical">
                <TextView android:id="@+id/searchCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingBottom="10dp" android:paddingTop="10dp" android:textColor="@color/text_faint" android:textSize="13sp"
                    android:fontFamily="@font/sora_semibold"/>
                <TextView android:id="@+id/searchEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingTop="12dp" android:textColor="@color/text_dim" android:textSize="15sp"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/searchResults" android:layout_width="match_parent"
                    android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false"
                    android:paddingBottom="24dp" android:overScrollMode="never" android:requiresFadingEdge="none"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- player -->
    <FrameLayout android:id="@+id/playerLayer" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#000000" android:visibility="gone">
        <androidx.media3.ui.PlayerView android:id="@+id/playerView" android:layout_width="match_parent"
            android:layout_height="match_parent" app:use_controller="false" app:resize_mode="fit"
            app:surface_type="surface_view" app:use_artwork="false"
            app:shutter_background_color="@android:color/transparent"/>
        <View android:id="@+id/playerScrim" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/scrim_player" android:alpha="0"/>
        <LinearLayout android:id="@+id/infoCard" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|start" android:layout_margin="40dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:minWidth="420dp" android:paddingStart="16dp" android:paddingEnd="30dp"
            android:paddingTop="16dp" android:paddingBottom="16dp" android:alpha="0">
            <FrameLayout android:id="@+id/infoLogoBox" android:layout_width="64dp" android:layout_height="64dp">
                <ImageView android:id="@+id/infoLogo" android:layout_width="42dp" android:layout_height="42dp"
                    android:layout_gravity="center" android:scaleType="fitCenter"/>
                <TextView android:id="@+id/infoMono" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:textSize="20sp" android:fontFamily="@font/sora_bold"
                    android:includeFontPadding="false" android:visibility="gone"/>
            </FrameLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="18dp" android:orientation="vertical">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIVE"
                        android:background="@drawable/live_pill" android:textColor="#FFFFFF" android:textSize="10sp"
                        android:fontFamily="@font/sora_bold" android:letterSpacing="0.08" android:paddingStart="8dp"
                        android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
                    <TextView android:id="@+id/infoCat" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" android:textColor="@color/text_dim" android:textSize="13sp"/>
                </LinearLayout>
                <TextView android:id="@+id/infoName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:maxWidth="620dp"
                    android:textColor="@color/text" android:textSize="24sp" android:fontFamily="@font/sora_semibold"/>
                <TextView android:id="@+id/infoNow" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:maxLines="1" android:ellipsize="end" android:maxWidth="620dp"
                    android:textColor="@color/text" android:textSize="15sp" android:visibility="gone"/>
                <ProgressBar android:id="@+id/infoProgress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="280dp" android:layout_height="3dp" android:minHeight="3dp" android:maxHeight="3dp"
                    android:layout_marginTop="7dp" android:max="1000" android:visibility="gone"/>
                <TextView android:id="@+id/infoDesc" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:maxLines="2" android:ellipsize="end" android:maxWidth="620dp"
                    android:textColor="@color/text_dim" android:textSize="12sp" android:visibility="gone"/>
                <TextView android:id="@+id/infoScheduleNext" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:maxWidth="620dp"
                    android:textColor="@color/text_dim" android:textSize="12sp" android:visibility="gone"/>
                <TextView android:id="@+id/infoNext" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:maxWidth="620dp"
                    android:textColor="@color/text_faint" android:textSize="11sp" android:visibility="gone"/>
                <LinearLayout android:id="@+id/infoActions" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
                    <TextView android:id="@+id/infoGuideAction" style="@style/Widget.AKTV.PlayerAction" android:text="GUIDE"/>
                    <TextView android:id="@+id/infoSourceAction" style="@style/Widget.AKTV.PlayerAction" android:text="SOURCE"/>
                    <TextView android:id="@+id/infoQualityAction" style="@style/Widget.AKTV.PlayerAction" android:text="PICTURE QUALITY"/>
                    <TextView android:id="@+id/infoRetryAction" style="@style/Widget.AKTV.PlayerAction" android:text="RETRY"/>
                </LinearLayout>
                <TextView android:id="@+id/infoHint" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="7dp" android:textColor="@color/text_faint" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>
        <TextClock android:id="@+id/playerClock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:layout_margin="36dp" android:format12Hour="h:mm" android:format24Hour="HH:mm"
            android:textColor="@color/text" android:textSize="20sp" android:fontFamily="@font/sora_regular" android:alpha="0"
            android:shadowColor="#99000000" android:shadowRadius="12"/>
        <!-- programme guide: dedicated EPG panel, separate from the channel-zap drawer -->
        <View android:id="@+id/programmeGuideScrim" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="#BA050813" android:visibility="gone" android:clickable="true" android:focusable="false"/>
        <LinearLayout android:id="@+id/programmeGuidePanel" android:layout_width="440dp" android:layout_height="match_parent"
            android:layout_gravity="end" android:layout_margin="16dp" android:orientation="vertical" android:padding="24dp"
            android:background="@drawable/guide_panel" android:visibility="gone" android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AK TV  /  LIVE"
                        android:textColor="@color/ion" android:textSize="10sp" android:fontFamily="@font/sora_bold" android:letterSpacing="0.12"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:text="Programme guide" android:textColor="@color/text" android:textSize="24sp" android:fontFamily="@font/sora_bold"/>
                </LinearLayout>
                <TextView android:id="@+id/programmeGuideClose" android:layout_width="48dp" android:layout_height="42dp" android:gravity="center"
                    android:text="✕" android:textColor="@color/text_dim" android:textSize="16sp" android:background="@drawable/player_action"
                    android:focusable="true" android:clickable="true" android:contentDescription="Close programme guide"/>
            </LinearLayout>
            <TextView android:id="@+id/programmeGuideChannel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:textColor="@color/text" android:textSize="16sp" android:fontFamily="@font/sora_semibold"
                android:maxLines="2" android:ellipsize="end"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:layout_marginBottom="12dp"
                android:background="#28FFFFFF"/>
            <TextView android:id="@+id/programmeGuideStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/text_dim" android:textSize="13sp" android:lineSpacingExtra="3dp"/>
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:layout_marginTop="8dp" android:fillViewport="false" android:overScrollMode="never">
                <LinearLayout android:id="@+id/programmeGuideEntries" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </ScrollView>
            <TextView android:id="@+id/programmeGuideCredit" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textColor="@color/text_faint" android:textSize="10sp" android:lineSpacingExtra="2dp"/>
        </LinearLayout>

        <!-- channel guide: Right opens, Left goes back -->
        <View android:id="@+id/guideScrim" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/scrim_guide" android:visibility="gone"/>
        <LinearLayout android:id="@+id/guide" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:layout_gravity="end" android:layout_margin="24dp" android:orientation="horizontal" android:padding="12dp"
            android:visibility="gone">
            <LinearLayout android:layout_width="250dp" android:layout_height="match_parent" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Categories"
                    android:paddingStart="14dp" android:paddingTop="10dp" android:paddingBottom="8dp"
                    android:textColor="@color/text_faint" android:textSize="13sp" android:fontFamily="@font/sora_semibold"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/catList" android:layout_width="match_parent"
                    android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false"
                    android:paddingBottom="24dp" android:overScrollMode="never" android:requiresFadingEdge="none"/>
            </LinearLayout>
            <View android:id="@+id/guideDivider" android:layout_width="1dp" android:layout_height="match_parent"
                android:layout_marginTop="14dp" android:layout_marginBottom="14dp" android:layout_marginStart="8dp"
                android:background="#1FFFFFFF" android:visibility="gone"/>
            <LinearLayout android:id="@+id/chCol" android:layout_width="340dp" android:layout_height="match_parent"
                android:layout_marginStart="8dp" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/chHeader" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingStart="12dp" android:paddingTop="10dp" android:paddingBottom="8dp"
                    android:textColor="@color/text_faint" android:textSize="13sp" android:fontFamily="@font/sora_semibold"/>
                <EditText android:id="@+id/channelSearch" android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginBottom="8dp"
                    android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true"
                    android:hint="Search channels…" android:textColor="@color/text" android:textColorHint="@color/text_faint"
                    android:textSize="13sp" android:fontFamily="@font/sora_regular" android:imeOptions="actionSearch"
                    android:background="@drawable/live_pill" android:focusable="true" android:focusableInTouchMode="true"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/chList" android:layout_width="match_parent"
                    android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false"
                    android:paddingBottom="24dp" android:overScrollMode="never" android:requiresFadingEdge="none"/>
            </LinearLayout>
        </LinearLayout>
        <ProgressBar android:id="@+id/spinner" android:layout_width="56dp" android:layout_height="56dp"
            android:layout_gravity="center" android:indeterminateTint="@color/ion" android:visibility="gone"/>
        <TextView android:id="@+id/playStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal" android:layout_marginTop="28dp" android:textColor="@color/text_dim"
            android:gravity="center" android:maxWidth="700dp" android:paddingStart="24dp" android:paddingEnd="24dp"
            android:textSize="14sp" android:visibility="gone"/>
    </FrameLayout>

    <!-- entrance -->
    <com.aktv.app.AkIntroView android:id="@+id/splash" android:layout_width="match_parent" android:layout_height="match_parent"
        android:clickable="true" android:focusable="false"/>
</FrameLayout>
