<?xml version="1.0" encoding="utf-8"?>
<!-- Manrope, body face on the Streamr site, as one variable file with three named weights. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/manrope_var" android:fontStyle="normal" android:fontWeight="400"
        android:fontVariationSettings="'wght' 400"/>
    <font android:font="@font/manrope_var" android:fontStyle="normal" android:fontWeight="600"
        android:fontVariationSettings="'wght' 600"/>
    <font android:font="@font/manrope_var" android:fontStyle="normal" android:fontWeight="700"
        android:fontVariationSettings="'wght' 700"/>
</font-family>
