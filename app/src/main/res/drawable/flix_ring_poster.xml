<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="160" android:exitFadeDuration="220">
    <item android:state_focused="true">
        <layer-list>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape><gradient android:angle="270" android:startColor="#29FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" android:centerY="0.4"/><corners android:radius="2dp"/></shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape><solid android:color="#00000000"/><corners android:radius="2dp"/><stroke android:width="2dp" android:color="#FFFCEE0A"/></shape>
            </item>
            <item><shape><solid android:color="#00000000"/><corners android:radius="3dp"/><stroke android:width="2.5dp" android:color="@color/brand_light"/></shape></item>
        </layer-list>
    </item>
    <item><shape><solid android:color="#00000000"/><corners android:radius="3dp"/><stroke android:width="1dp" android:color="#1FFFFFFF"/></shape></item>
</selector>
