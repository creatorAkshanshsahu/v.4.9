<!-- The site's card scrim: scrim/90 at the bottom fading to nothing at the top. Angle 270 runs
     top (start) to bottom (end), so the card's copy always has a dark floor under it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="270"
        android:startColor="#000B0C10"
        android:centerColor="#8C0B0C10"
        android:endColor="#F20A0B0E"
        android:type="linear"/>
    <corners android:radius="14dp"/>
</shape>
