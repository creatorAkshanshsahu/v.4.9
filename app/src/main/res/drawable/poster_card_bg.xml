<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:top="-3dp" android:bottom="-3dp" android:left="-3dp" android:right="-3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#00000000"/>
                    <stroke android:width="6dp" android:color="#558AB4F8"/>
                    <corners android:radius="22dp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#1C2433"/>
                    <stroke android:width="2.5dp" android:color="#FFFFFF"/>
                    <corners android:radius="18dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#00000000"/><corners android:radius="18dp"/></shape>
    </item>
</selector>
