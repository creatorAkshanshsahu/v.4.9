<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:type="linear" android:angle="270"
                android:startColor="#3DFF3448" android:endColor="#0FE11D2E"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1.5dp" android:color="#CCFF3448"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#0F0810"/>
            <corners android:radius="16dp"/>
            <stroke android:width="1dp" android:color="#2A1520"/>
        </shape>
    </item>
</selector>
