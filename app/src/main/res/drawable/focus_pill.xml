<!-- Reusable glossy crimson pill for rail items and action buttons. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:type="linear" android:angle="270"
                android:startColor="#FFFF4A5C" android:centerColor="#FFE11D2E" android:endColor="#FF8C0F1C"/>
            <corners android:radius="100dp"/>
            <stroke android:width="1.5dp" android:color="#55FFEBEE"/>
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <gradient android:type="linear" android:angle="270"
                android:startColor="#66E11D2E" android:endColor="#338C0F1C"/>
            <corners android:radius="100dp"/>
            <stroke android:width="1dp" android:color="#99FF3448"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
</selector>
