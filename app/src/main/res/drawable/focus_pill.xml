<!-- Reusable glossy crimson pill for rail items and action buttons. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:type="linear" android:angle="270"
                android:startColor="#FFE5383B" android:centerColor="#FFC4161C" android:endColor="#FF8A0F14"/>
            <corners android:radius="100dp"/>
            <stroke android:width="1.5dp" android:color="#55F5F5F5"/>
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <gradient android:type="linear" android:angle="270"
                android:startColor="#66C4161C" android:endColor="#338A0F14"/>
            <corners android:radius="100dp"/>
            <stroke android:width="1dp" android:color="#99E5383B"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
</selector>
