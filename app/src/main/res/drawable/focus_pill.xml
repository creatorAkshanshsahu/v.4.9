<!-- Cyber neon pill for guide & action buttons. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:type="linear" android:angle="0"
                android:startColor="#FFFF00D0" android:endColor="#FF00ECF7"/>
            <corners android:radius="100dp"/>
            <stroke android:width="2dp" android:color="#FFFFFFFF"/>
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <gradient android:type="linear" android:angle="0"
                android:startColor="#66FF00D0" android:endColor="#4400ECF7"/>
            <corners android:radius="100dp"/>
            <stroke android:width="1dp" android:color="#9900ECF7"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
</selector>
