<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="160" android:exitFadeDuration="200">
    <item android:state_focused="true">
        <layer-list>
            <item><shape android:shape="oval"><gradient android:angle="0" android:startColor="#FFFF00D0" android:centerColor="#FF7B5CFF" android:endColor="#FF00ECF7"/></shape></item>
            <item><shape android:shape="oval"><gradient android:angle="270" android:startColor="#40FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" android:centerY="0.5"/></shape></item>
            <item><shape android:shape="oval"><solid android:color="#00000000"/><stroke android:width="1.5dp" android:color="#E6FFFFFF"/></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="oval"><solid android:color="#B3100A23"/></shape></item>
            <item><shape android:shape="oval"><gradient android:angle="270" android:startColor="#24FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" android:centerY="0.5"/></shape></item>
            <item><shape android:shape="oval"><solid android:color="#00000000"/><stroke android:width="1dp" android:color="#38FFFFFF"/></shape></item>
        </layer-list>
    </item>
</selector>
