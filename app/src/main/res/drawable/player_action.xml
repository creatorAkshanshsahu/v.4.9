<!-- Player action chip: cyber glass at rest, electric cyan ring on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#CC1B1630"/>
            <corners android:radius="12dp"/>
            <stroke android:width="2dp" android:color="@color/signal"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#B3100A23"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#4000ECF7"/>
        </shape>
    </item>
</selector>
