<!-- Player control: frosted ink glass at rest; STREAMR aurora (magenta -> violet -> cyan) with a white rim on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="160" android:exitFadeDuration="200">
    <item android:state_focused="true">
        <layer-list>
            <item><shape><gradient android:angle="0" android:startColor="#FFFF00D0" android:centerColor="#FF7B5CFF" android:endColor="#FF00ECF7"/><corners android:radius="100dp"/></shape></item>
            <item><shape><gradient android:angle="270" android:startColor="#40FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" android:centerY="0.5"/><corners android:radius="100dp"/></shape></item>
            <item><shape><solid android:color="#00000000"/><stroke android:width="1.5dp" android:color="#CCFFFFFF"/><corners android:radius="100dp"/></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="#B3100A23"/><corners android:radius="100dp"/></shape></item>
            <item><shape><gradient android:angle="270" android:startColor="#24FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" android:centerY="0.5"/><corners android:radius="100dp"/></shape></item>
            <item><shape><solid android:color="#00000000"/><stroke android:width="1dp" android:color="#59FFFFFF"/><corners android:radius="100dp"/></shape></item>
        </layer-list>
    </item>
</selector>
