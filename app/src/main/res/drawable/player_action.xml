<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient android:type="linear" android:angle="270"
                android:startColor="#FFFF4A5C" android:centerColor="#FFE11D2E" android:endColor="#FF8C0F1C"/>
            <corners android:radius="18dp"/>
            <stroke android:width="1.5dp" android:color="#88FFEBEE"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#E00C0710"/>
            <corners android:radius="18dp"/>
            <stroke android:width="1dp" android:color="#66FF3448"/>
        </shape>
    </item>
</selector>
