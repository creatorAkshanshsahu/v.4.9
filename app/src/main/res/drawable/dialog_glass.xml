<!-- Frosted glass sheet for dialogs: dense ink body, specular top, white rim. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16dp">
    <layer-list>
        <item><shape><solid android:color="#F2121628"/><corners android:radius="28dp"/></shape></item>
        <item><shape><gradient android:angle="270" android:startColor="#22FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" android:centerY="0.45"/>
                <corners android:radius="28dp"/></shape></item>
        <item><shape><solid android:color="#00000000"/><stroke android:width="1dp" android:color="#3DFFFFFF"/><corners android:radius="28dp"/></shape></item>
    </layer-list>
</inset>
