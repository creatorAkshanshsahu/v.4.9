<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="160" android:exitFadeDuration="220">
    <item android:state_focused="true">
        <layer-list>
            <item><shape><gradient android:angle="270" android:startColor="#2EFFFFFF" android:centerColor="#0A00ECF7" android:endColor="#0000ECF7"/><corners android:radius="12dp"/></shape></item>
            <item><shape><solid android:color="#00000000"/><corners android:radius="12dp"/><stroke android:width="2.5dp" android:color="@color/signal"/></shape></item>
        </layer-list>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#00000000"/><corners android:radius="12dp"/><stroke android:width="2dp" android:color="@color/brand"/></shape>
    </item>
    <item><shape><solid android:color="#00000000"/><corners android:radius="12dp"/><stroke android:width="1dp" android:color="#24FFFFFF"/></shape></item>
</selector>
