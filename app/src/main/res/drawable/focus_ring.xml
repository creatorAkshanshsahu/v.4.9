<!-- STREAMR cyber focus (styles.css --shadow-focus): 2.5dp electric cyan ring over cyber glass. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A00ECF7"/>
            <corners android:radius="12dp"/>
            <stroke android:width="2.5dp" android:color="@color/signal"/>
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <corners android:radius="12dp"/>
            <stroke android:width="2dp" android:color="@color/brand"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#2800ECF7"/>
        </shape>
    </item>
</selector>
