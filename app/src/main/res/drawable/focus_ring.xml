<!-- Glass card rim: white specular rim at rest, aurora rim with a soft inner bloom on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="180" android:exitFadeDuration="240">
    <item android:state_focused="true">
        <layer-list>
            <item><shape><gradient android:angle="270" android:startColor="#33FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF"/><corners android:radius="18dp"/></shape></item>
            <item><shape><solid android:color="#00000000"/><stroke android:width="2dp" android:color="#FFFFFFFF"/><corners android:radius="18dp"/></shape></item>
        </layer-list>
    </item>
    <item android:state_activated="true"><shape><solid android:color="#00000000"/><stroke android:width="1.5dp" android:color="#B3FF7A9C"/><corners android:radius="18dp"/></shape></item>
    <item><shape><solid android:color="#00000000"/><stroke android:width="1dp" android:color="#2EFFFFFF"/><corners android:radius="18dp"/></shape></item>
</selector>
