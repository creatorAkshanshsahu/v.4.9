+/**
+ * What the first bytes of a 200 body say when they contradict the manifest the URL promised.
+ *
+ * Extension sniffing calls anything at a `.m3u8` address HLS, but a reseller whose link expired
+ * answers 200 with an HTML error page, and some `.m3u8` addresses serve raw MPEG-TS. Serving
+ * either to hls.js as a playlist produces "not an HLS playlist" fatals in the browser for a
+ * body the server already held. `null` means the head confirms nothing either way and the
+ * existing content-type/extension verdict stands.
+ */
+export function sniffUpstreamHead(headText: string, firstByte: number | undefined): "html" | "ts" | null {
+  if (/^<!doctype|^<html|^<head|^<title|^<body/i.test(headText)) return "html";
+  // 0x47 is the MPEG-TS sync byte: no playlist (`#`), MPD (`<`) or HTML page starts with it.
+  if (firstByte === 0x47) return "ts";
+  return null;
+}
