+describe("Reseller-suffixed names still match the JioTV rescue catalogue", () => {
+  it("strips a trailing reseller tag before matching, without touching honest names", async () => {
+    const { normalizeChannelMatchTokens } = await import("@/lib/live-gateway");
+    expect(normalizeChannelMatchTokens("CNBC Awaaz By Premium PlugX").base).toBe("cnbc awaaz");
+    expect(normalizeChannelMatchTokens("DISCOVERY By Premium PlugX").base).toBe("discovery");
+    expect(normalizeChannelMatchTokens("Star Sports 1 Hindi By Nova IPTV").numbers).toEqual(["1"]);
+    // Not tags: no space before "by", or nothing after it.
+    expect(normalizeChannelMatchTokens("Baby TV").base).toBe("baby tv");
+    expect(normalizeChannelMatchTokens("Stand By").base).toBe("stand by");
+  });
+
+  it("matches a reseller entry to its JioTV namesake for the browser-direct rescue", async () => {
+    const { findBestGioTvMatch } = await import("@/lib/live-gateway");
+    const records = [
+      { id: "377", name: "CNBC Awaaz", category: "News", logo: "", urls: [], keys: [] },
+      { id: "114", name: "Discovery HD", category: "Infotainment", logo: "", urls: [], keys: [] },
+    ];
+    const cnbc = findBestGioTvMatch(records, "tg:2752", "CNBC Awaaz By Premium PlugX");
+    expect(cnbc?.id).toBe("377");
+    // "DISCOVERY" has no bare Jio namesake, but it is "Discovery HD" minus the quality word.
+    const discovery = findBestGioTvMatch(records, "tg:2423", "DISCOVERY By Premium PlugX");
+    expect(discovery?.id).toBe("114");
+  });
+});
+
+describe("AK TV reseller failures refuse honestly instead of serving garbage as HLS", () => {
+  const RESELLER_M3U = `#EXTM3U
+#EXTINF:-1 tvg-id="2752" group-title="News",CNBC Awaaz By Premium PlugX
+https://reseller.example/tee/playlist.php/CNBC.m3u8
+#EXTINF:-1 tvg-id="2423" group-title="Infotainment",DISCOVERY By Premium PlugX
+https://reseller.example/tee/playlist.php/DISCOVERY.m3u8
+`;
+
+  it("refuses an HTML error page with an expiry sentence and the browser recipe, not HLS", async () => {
+    vi.stubGlobal("fetch", async (url: string) => {
+      const u = String(url);
+      if (u.includes("livetgtv.lovable.app")) return new Response(RESELLER_M3U, { status: 200 });
+      if (u.includes("reseller.example")) {
+        return new Response("<html><head><title>Link expired</title></head><body>expired</body></html>", {
+          status: 200,
+          headers: { "content-type": "text/html" },
+        });
+      }
+      return new Response("", { status: 404 });
+    });
+
+    const { maybeHandleLiveRequest } = await import("@/lib/live-gateway");
+    const res = await maybeHandleLiveRequest(
+      new Request("https://screen-safari-studio.lovable.app/api/live/stream/tg:2752.ts?probe=1"),
+      {},
+    );
+    expect(res!.status).toBe(502);
+    const body = (await res!.json()) as { error: string; directPlay?: { url: string; container: string } };
+    expect(body.error).toContain("error page instead of a playlist");
+    expect(body.error).toContain("most likely expired");
+    expect(body.directPlay?.url).toContain("reseller.example");
+    expect(body.directPlay?.container).toBe("hls");
+  });
+
+  it("serves raw MPEG-TS behind a .m3u8 address as MPEG-TS so the probe names the TS engine", async () => {
+    const ts = new Uint8Array(376);
+    ts[0] = 0x47;
+    ts[188] = 0x47;
+    vi.stubGlobal("fetch", async (url: string) => {
+      const u = String(url);
+      if (u.includes("livetgtv.lovable.app")) return new Response(RESELLER_M3U, { status: 200 });
+      if (u.includes("reseller.example")) {
+        return new Response(ts, { status: 200, headers: { "content-type": "video/mp2t" } });
+      }
+      return new Response("", { status: 404 });
+    });
+
+    const { maybeHandleLiveRequest } = await import("@/lib/live-gateway");
+    const probe = await maybeHandleLiveRequest(
+      new Request("https://screen-safari-studio.lovable.app/api/live/stream/tg:2752.ts?probe=1"),
+      {},
+    );
+    expect(probe!.status).toBe(200);
+    expect(probe!.headers.get("x-stream-container")).toBe("mpegts");
+    // And the player's follow-up request streams the bytes the probe put aside.
+    const play = await maybeHandleLiveRequest(
+      new Request("https://screen-safari-studio.lovable.app/api/live/stream/tg:2752.ts"),
+      {},
+    );
+    expect(play!.status).toBe(200);
+    expect(play!.headers.get("x-stream-container")).toBe("mpegts");
+    expect(play!.headers.get("content-type")).toContain("video/mp2t");
+  });
+
+  it("tells the viewer the browser fallback failed too when a reseller gate refuses the relay", async () => {
+    vi.stubGlobal("fetch", async (url: string) => {
+      const u = String(url);
+      if (u.includes("livetgtv.lovable.app")) return new Response(RESELLER_M3U, { status: 200 });
+      // The gate refuses the relay everywhere: the manifest fetch and the recipe's resolve.
+      if (u.includes("reseller.example")) return new Response("blocked", { status: 530 });
+      return new Response("", { status: 404 });
+    });
+
+    const { maybeHandleLiveRequest } = await import("@/lib/live-gateway");
+    const res = await maybeHandleLiveRequest(
+      new Request("https://screen-safari-studio.lovable.app/api/live/stream/tg:2423.ts?probe=1"),
+      {},
+    );
+    expect(res!.status).toBe(502);
+    const body = (await res!.json()) as { error: string; directPlay?: { url: string } };
+    expect(body.error).toContain("HTTP 530");
+    expect(body.error).toContain("browser-direct fallback failed too");
+    expect(body.error).not.toContain("Playing it directly from your browser instead");
+    expect(body.directPlay?.url).toContain("reseller.example");
+  });
+
+  it("pins the first-byte sniffing the stream route trusts over the URL extension", async () => {
+    const { sniffUpstreamHead } = await import("@/lib/live-gateway");
+    expect(sniffUpstreamHead("<!DOCTYPE HTML><html>", 0x3c)).toBe("html");
+    expect(sniffUpstreamHead("<html><body>expired</body></html>", 0x3c)).toBe("html");
+    expect(sniffUpstreamHead("G", 0x47)).toBe("ts");
+    // A playlist, an MPD and an inconclusive head all leave the extension verdict standing.
+    expect(sniffUpstreamHead("#EXTM3U", 0x23)).toBeNull();
+    expect(sniffUpstreamHead("<?xml version=\"1.0\"?>", 0x3c)).toBeNull();
+    expect(sniffUpstreamHead("<MPD", 0x3c)).toBeNull();
+    expect(sniffUpstreamHead("", undefined)).toBeNull();
+  });
+});
+
