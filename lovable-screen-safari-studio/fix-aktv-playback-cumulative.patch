+/** Resolve after `ms` with no value: racing an engine `<script>` load so a stalled `/vendor` fetch can never hang the player. */
+export function delayMs(ms: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+/**
+ * How many of this pass's stalled attempts share `url`'s host. Two stalls on one host skips
+ * its remaining candidates — a new token cannot fix a host that never answers — while other
+ * hosts are always tried, so a dead server never murders the failover to a live one.
+ */
+export function hostStallCount(url: string, stalledUrls: string[]): number {
+  return stalledUrls.filter((u) => sameUrlHost(u, url)).length;
+}
