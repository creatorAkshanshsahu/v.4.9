+/** A browser-direct attempt's verdict: frames, a fast refusal, or a hang. Shared with the DASH path's own tri-state. */
+export type AttemptOutcome = "played" | "refused" | "stalled";
+
+/**
+ * An HLS attempt that never produced frames: did the host refuse (another token may work)
+ * or did nothing answer (nothing will, on this host, in this pass)?
+ *
+ * Only a real HTTP refusal keeps the pass going at full length: timeouts and status-less
+ * fatals are stalls, and two stalls on one host skip its remaining candidates.
+ */
+export function classifyHlsAttemptOutcome(fatalDetail: unknown): "refused" | "stalled" {
+  const d = (fatalDetail ?? {}) as { response?: { code?: unknown } };
+  const rawStatus = d.response?.code;
+  if (typeof rawStatus === "number" && rawStatus >= 400) return "refused";
+  return "stalled";
+}
